exports[`post-consolidation public contract snapshots records the staged workflow file contract and provider job shape 1`] = `
{
  "files": [
    {
      "gated": true,
      "name": "ALPHACI 1 Access",
      "path": ".github/workflows/00-alphaci-access.yml",
      "stage": "access",
    },
    {
      "gated": true,
      "name": "ALPHACI 2 Quality",
      "path": ".github/workflows/10-alphaci-quality.yml",
      "stage": "quality",
    },
    {
      "gated": true,
      "name": "ALPHACI 3 Build and Deploy",
      "path": ".github/workflows/20-alphaci-package.yml",
      "stage": "package",
    },
    {
      "gated": false,
      "name": "ALPHACI Env Guard",
      "path": ".github/workflows/05-alphaci-env-guard.yml",
      "stage": "guard",
    },
  ],
  "providerJobs": {
    "deploy-render-backend-uat": {
      "if": "\${{ (needs.pipeline-context.outputs.branch) == 'uat' }}",
      "needs": [
        "pipeline-context",
        "docker-backend-uat",
      ],
      "secrets": {
        "ALPHACI_API_URL": "\${{ secrets.ALPHACI_API_URL }}",
        "ALPHACI_TOKEN": "\${{ secrets.ALPHACI_TOKEN }}",
      },
      "uses": "Alpha-Explora/alphaci-workflow/.github/workflows/release.yml@v1",
      "with": {
        "artifact": "\${{ needs.docker-backend-uat.outputs.image-repo }}:sha-\${{ needs.pipeline-context.outputs.sha }}",
        "branch": "uat",
        "commit-sha": "\${{ needs.pipeline-context.outputs.sha }}",
        "healthcheck-path": "/health",
        "slot": "backend",
        "system-name": "orders-api",
      },
    },
    "deploy-vercel-frontend-dev": {
      "if": "\${{ (needs.pipeline-context.outputs.branch) == 'dev' }}",
      "needs": [
        "pipeline-context",
        "build",
      ],
      "secrets": {
        "GH_PR_TOKEN": "\${{ secrets.GH_PR_TOKEN != '' && secrets.GH_PR_TOKEN || github.token }}",
        "VERCEL_ORG_ID": "\${{ secrets.VERCEL_FRONTEND_ORG_ID }}",
        "VERCEL_PROJECT_ID": "\${{ secrets.VERCEL_FRONTEND_PROJECT_ID }}",
        "VERCEL_TOKEN": "\${{ secrets.VERCEL_FRONTEND_TOKEN }}",
      },
      "uses": "Alpha-Explora/alphaci-workflow/.github/workflows/vercel-deploy.yml@v1",
      "with": {
        "branch-alias": "dev-\${{ vars.VERCEL_ALIAS }}",
        "checkout-ref": "\${{ needs.pipeline-context.outputs.sha }}",
        "environment": "preview",
        "system-name": "orders-api",
        "working-directory": "frontend",
      },
    },
    "deploy-vercel-frontend-main": {
      "if": "\${{ (needs.pipeline-context.outputs.branch) == 'main' }}",
      "needs": [
        "pipeline-context",
        "build",
        "production-gate",
      ],
      "secrets": {
        "GH_PR_TOKEN": "\${{ secrets.GH_PR_TOKEN != '' && secrets.GH_PR_TOKEN || github.token }}",
        "VERCEL_ORG_ID": "\${{ secrets.VERCEL_FRONTEND_ORG_ID }}",
        "VERCEL_PROJECT_ID": "\${{ secrets.VERCEL_FRONTEND_PROJECT_ID }}",
        "VERCEL_TOKEN": "\${{ secrets.VERCEL_FRONTEND_TOKEN }}",
      },
      "uses": "Alpha-Explora/alphaci-workflow/.github/workflows/vercel-deploy.yml@v1",
      "with": {
        "checkout-ref": "\${{ needs.pipeline-context.outputs.sha }}",
        "environment": "production",
        "system-name": "orders-api",
        "working-directory": "frontend",
      },
    },
    "deploy-vercel-frontend-uat": {
      "if": "\${{ (needs.pipeline-context.outputs.branch) == 'uat' }}",
      "needs": [
        "pipeline-context",
        "build",
      ],
      "secrets": {
        "GH_PR_TOKEN": "\${{ secrets.GH_PR_TOKEN != '' && secrets.GH_PR_TOKEN || github.token }}",
        "VERCEL_ORG_ID": "\${{ secrets.VERCEL_FRONTEND_ORG_ID }}",
        "VERCEL_PROJECT_ID": "\${{ secrets.VERCEL_FRONTEND_PROJECT_ID }}",
        "VERCEL_TOKEN": "\${{ secrets.VERCEL_FRONTEND_TOKEN }}",
      },
      "uses": "Alpha-Explora/alphaci-workflow/.github/workflows/vercel-deploy.yml@v1",
      "with": {
        "branch-alias": "uat-\${{ vars.VERCEL_ALIAS }}",
        "checkout-ref": "\${{ needs.pipeline-context.outputs.sha }}",
        "environment": "preview",
        "system-name": "orders-api",
        "working-directory": "frontend",
      },
    },
    "docker-backend-uat": {
      "if": "\${{ (needs.pipeline-context.outputs.branch) == 'uat' }}",
      "needs": [
        "pipeline-context",
        "build",
      ],
      "permissions": {
        "contents": "read",
        "packages": "write",
        "security-events": "write",
      },
      "uses": "Alpha-Explora/alphaci-workflow/.github/workflows/docker-build.yml@v1",
      "with": {
        "checkout-ref": "\${{ needs.pipeline-context.outputs.sha }}",
        "dockerfile-path": "Dockerfile",
        "fail-on-vulnerabilities": true,
        "image-name": "alphaci-backend-uat-orders-api",
        "pipeline-branch": "uat",
        "push-image": true,
        "scan-vulnerabilities": true,
        "working-directory": "backend",
      },
    },
  },
}
`;
