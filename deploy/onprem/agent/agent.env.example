# AlphaCI on-prem release agent configuration (/opt/alphaci/agent.env, mode 0600).
ALPHACI_API_URL=https://api.alphaci.example
# The host token shown once when an admin registers this host.
ALPHACI_HOST_TOKEN_FILE=/opt/alphaci/secrets/host-token
# AlphaCI's release-signing public key (PEM). Releases signed with any other key are refused.
ALPHACI_TRUST_KEY=/opt/alphaci/trust/release-signing.pub.pem
# The customer's Compose file. Services use ${ALPHACI_IMAGE_BACKEND}, ${ALPHACI_IMAGE_FRONTEND}, ...
ALPHACI_COMPOSE_FILE=/opt/alphaci/compose/compose.yaml
ALPHACI_COMPOSE_PROJECT=alphaci
ALPHACI_STATE_DIR=/opt/alphaci/releases
# The name clients use to reach the apps; the example Caddyfile serves it.
ALPHACI_HOSTNAME=apps.client.example
# Optional URL that must answer 2xx after Compose reports the services healthy.
# With the example stack, use https://<ALPHACI_HOSTNAME>/ and, inside WSL, map
# that name to 127.0.0.1 in /etc/hosts and trust the client's CA
# (/usr/local/share/ca-certificates, then update-ca-certificates).
ALPHACI_HEALTH_URL=
ALPHACI_HEALTH_TIMEOUT=120
# Where `alphaci-agent support-bundle` writes its archive.
ALPHACI_SUPPORT_DIR=/opt/alphaci/support
