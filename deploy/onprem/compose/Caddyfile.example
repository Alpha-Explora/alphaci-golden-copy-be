# Example /opt/alphaci/compose/Caddyfile. TLS uses the client's certificate:
# /opt/alphaci/tls/cert.pem (full chain) and key.pem. For a lab without one,
# replace the tls line with "tls internal".
{
	auto_https disable_redirects
}

{$ALPHACI_HOSTNAME}:443 {
	tls /tls/cert.pem /tls/key.pem
	encode gzip
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle {
		reverse_proxy frontend:8080
	}
}

# Plain HTTP on the Compose network only (port 80 is not published). The
# optional `tunnel` service in compose.yaml sends public traffic here, so the
# public hostname is configured in the tunnel provider and not in this file.
:80 {
	encode gzip
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle {
		reverse_proxy frontend:8080
	}
}
