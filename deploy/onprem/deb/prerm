#!/bin/sh
# Stops polling when the package is removed. Credentials, trust keys and assignment
# data stay under /opt/alphaci until an operator deletes them.
set -e
case "$1" in
  remove|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl disable --now alphaci-machine.timer >/dev/null 2>&1 || true
      systemctl stop alphaci-machine.service >/dev/null 2>&1 || true
    fi
    # Ends the automatic-address tunnels. A package without tunnel.sh has none to end.
    if [ -x /opt/alphaci/bin/alphaci-supervisor ] && [ -f /opt/alphaci/bin/tunnel.sh ]; then
      /opt/alphaci/bin/alphaci-supervisor --stop-tunnels || true
    fi
    ;;
esac
exit 0
