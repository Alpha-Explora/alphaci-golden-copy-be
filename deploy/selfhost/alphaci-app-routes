#!/bin/bash
# Routes each environment deployed on this server to its permanent address.
#
# AlphaCI gives every environment with a frontend
# https://<environment>-<repository>.<ONPREM_APPS_DOMAIN> (production:
# https://<repository>.<ONPREM_APPS_DOMAIN>) when that setting is
# present. This reads the on-prem agent's assignments on the same server, writes
# one Caddy site per address (proxying to the environment's host port), and
# reloads the install's Caddy only when the routes changed. Caddy then obtains
# each name's certificate itself. Run by alphaci-app-routes.timer.
set -euo pipefail
INSTALL="${ALPHACI_INSTALL_DIR:-/opt/alphaci}"
AGENT="${ALPHACI_HOME:-/opt/alphaci}"
OUT="$INSTALL/caddy/apps/apps.caddy"

domain=$(sed -n 's/^ONPREM_APPS_DOMAIN=//p' "$INSTALL/alphaci.env" | tr -d '"'"'"' \r' | tr '[:upper:]' '[:lower:]' | tail -n 1)
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
echo '# Generated by alphaci-app-routes; changes are overwritten.' > "$tmp"
if [ -n "$domain" ]; then
  # Every enrollment on this server: the default one and any instance under
  # instances/<name> (one server enrolled in several workspaces).
  for file in "$AGENT"/assignments/*/*/pending.json "$AGENT"/instances/*/assignments/*/*/pending.json; do
    [ -f "$file" ] || continue
    # "<host> <port>": the address's host, and the frontend's host port (or the
    # only port). Anything that is not a label under the domain is skipped.
    jq -r '.[0].assignment.machine.config as $c
      | ($c.ingress.publicUrl // "" | sub("^https://"; "") | sub("/.*$"; "")) as $host
      | ($c.ports | (map(select(.slot == "frontend"))[0] // .[0]).hostPort) as $port
      | "\($host) \($port)"' "$file" 2>/dev/null || true
  done | grep -E "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.${domain//./\\.} [0-9]{1,5}$" | sort -u -k1,1 |
    while read -r host port; do
      printf '%s {\n\tencode zstd gzip\n\treverse_proxy host.docker.internal:%s\n}\n' "$host" "$port"
    done >> "$tmp"
fi
if ! cmp -s "$tmp" "$OUT"; then
  install -m 0644 "$tmp" "$OUT"
  docker compose --project-directory "$INSTALL" exec -T proxy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
  echo "App routes updated: $(grep -c ' {$' "$OUT" || true) address(es)."
fi
