# =============================================================================
# alphaci.env: non-secret settings for the AlphaCI backend and the edge.
#
# Do not put secrets here. Secrets live in secrets/ and are referenced through
# the *_FILE variables below, which point at the container paths compose mounts.
# alphaci-ctl init writes this file with the values filled in for one hostname.
# This example is the reference. The keys must match what init writes; a unit
# test checks that.
#
# Format: KEY=value, one per line. Do not quote values. Blank values are "unset".
# Edit this file, then run: ./alphaci-ctl doctor
# =============================================================================

# --- Public address ----------------------------------------------------------
# One hostname drives every URL below. Change it here and change the derived
# lines to match. doctor fails when they disagree.
ALPHACI_HOSTNAME=alphaci.example.com

# How Caddy serves HTTPS. Empty is automatic certificates from a public CA,
# which needs public DNS for ALPHACI_HOSTNAME and inbound 80 and 443.
#   internal                              Caddy's private CA. Lab use. Browsers
#                                         and GitHub will not trust it.
#   /certs/fullchain.pem /certs/privkey.pem
#                                         the customer's own certificate, placed
#                                         in deploy/selfhost/certs/ (PEM)
ALPHACI_TLS_DIRECTIVE=

# Derived from ALPHACI_HOSTNAME. The backend needs these exact values.
PLATFORM_PUBLIC_URL=https://alphaci.example.com
FRONTEND_URL=https://alphaci.example.com
ALLOWED_ORIGINS=https://alphaci.example.com
GITHUB_CALLBACK_URL=https://alphaci.example.com/api/v1/auth/github/callback

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=4000
# The enterprise edition is the self-hosted product.
ALPHACI_EDITION=enterprise
# The build profile must match the edition. The frontend image is built for the
# same enterprise profile for every customer, so there is no separate profile.
ALPHACI_BUILD_PROFILE=enterprise
# Marks the install as self-hosted. The backend then uses the Postgres session
# store and needs no Supabase client settings.
ALPHACI_DEPLOYMENT_MODE=selfhosted
# No billing in self-hosted. Keep this false.
SUBSCRIPTION_GATE_ENABLED=false
# Swagger is a development tool. Keep it off in the appliance.
ENABLE_SWAGGER=false
# Caddy is the one proxy hop in front of the API. Express trusts exactly that
# many X-Forwarded-For hops, so clients cannot spoof their address.
TRUST_PROXY_HOPS=1
# The browser reaches the appliance over HTTPS, so the session cookie is Secure.
SESSION_SECURE=true
# Frontend and API share one origin, so Lax is correct. Do not change it to None.
SESSION_COOKIE_SAMESITE=lax
# Sessions live in the database, not in process memory, so a restart keeps them.
SESSION_STORE_DRIVER=postgres
# QA attachments are stored in the database (bytea), so no object store is needed.
STORAGE_DRIVER=postgres
# How often the in-process outbox relay delivers audit and notification events.
# No separate service is needed. 0 turns it off.
OUTBOX_RELAY_INTERVAL_MS=15000

# --- Release signing (AlphaCI signs releases with a key the customer holds) ---
# file: the backend signs with the P-256 key at the path below. runner would
# make a GitHub-hosted job sign instead, which the self-hosted profile does not use.
ALPHACI_RELEASE_SIGNER=file
ALPHACI_RELEASE_SIGNING_KEY_FILE=/run/secrets/release_signing_key

# --- GitHub App and OAuth App -----------------------------------------------
# The values below are not secret. Create the apps first (see the install
# runbook), then fill these in.
#   GITHUB_CLIENT_ID    OAuth App client ID
#   GITHUB_APP_ID       GitHub App ID (digits)
#   GITHUB_APP_SLUG     GitHub App slug, the name in its public URL
#   GITHUB_ENFORCED_ORG the customer's GitHub organization. Repositories are
#                       created and checked against it.
GITHUB_CLIENT_ID=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_ENFORCED_ORG=
# Where the member directory reads people from: github_org (the organization)
# or accounts (AlphaCI accounts only).
MEMBER_DIRECTORY_SOURCE=github_org
# stub: hierarchy grants and revocations are not written to GitHub teams.
# live: they are, so the GitHub App needs the organization permissions for it.
# Choose live only after those permissions are granted.
HIERARCHY_GITHUB_SYNC_MODE=stub

# --- Secrets, read from files (do not set the values here) -------------------
# Written by alphaci-ctl init: session_secret, database_url (carries the
# database password), release_signing_key, env_provisioning_encryption_key
# (32 random bytes, base64; it encrypts stored environment tokens, so back it up).
DATABASE_URL_FILE=/run/secrets/database_url
SESSION_SECRET_FILE=/run/secrets/session_secret
# Placed by the operator from the GitHub Apps and OAuth App settings pages:
# github_oauth_client_secret, github_app_private_key (the PEM the app
# generated), github_app_webhook_secret (the webhook secret you chose).
ENV_PROVISIONING_ENCRYPTION_KEY_FILE=/run/secrets/env_provisioning_encryption_key
GITHUB_CLIENT_SECRET_FILE=/run/secrets/github_oauth_client_secret
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key
GITHUB_APP_WEBHOOK_SECRET_FILE=/run/secrets/github_app_webhook_secret

# --- Optional, for an external PostgreSQL instead of the bundled db ----------
# Not used by the bundled db. For an external server, set DATABASE_URL_FILE to
# a URL with sslmode=require or verify-full, and point DATABASE_CA_CERT at the
# server's CA certificate (PEM, one line with \n escapes or a file-mounted value).
# DATABASE_CA_CERT=

# --- Not set in self-hosted -------------------------------------------------
# The SaaS hosting and provider integrations (Render, Vercel, GCP, Sonar and
# similar) stay off, because their settings are absent. Do not add them here.
#
# All SUPABASE_* settings are optional in selfhosted mode. Leave them unset.
