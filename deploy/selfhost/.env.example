# Image pins for the AlphaCI appliance. Copy to .env and fill in the digests from
# the release you are installing. Compose reads this file for interpolation in
# compose.yaml. Do not put secrets here.
#
# Upgrade: change the digests, then (see docs/runbooks/runbook-selfhost-install.md):
#   docker compose pull && docker compose up -d
# migrate runs before api on every up, so a schema change applies first.

# Backend image: API, migration runner and CLI (one image).
ALPHACI_API_IMAGE=ghcr.io/alpha-explora/alphaci-be@sha256:REPLACE_WITH_RELEASE_DIGEST

# Frontend image.
ALPHACI_WEB_IMAGE=ghcr.io/alpha-explora/alphaci-fe@sha256:REPLACE_WITH_RELEASE_DIGEST

# Optional overrides. The defaults are a supported PostgreSQL 16 and Caddy 2.
# ALPHACI_DB_IMAGE=postgres:16-alpine
# ALPHACI_PROXY_IMAGE=caddy:2-alpine

# Host ports for the edge. Change them when 80 or 443 are taken.
# ALPHACI_HTTP_PORT=80
# ALPHACI_HTTPS_PORT=443
