# Enterprise deployment dedicated to one client.
#
# Set ALPHACI_CLIENT alone when the policy is declared in
# src/packs/enterprise/clients and ships with the product.
#
# Set ALPHACI_CLIENT_CONFIG for a customer-hosted installation that supplies
# its own policy document. When both are set the document must name the same
# client. See deploy/env/client-policy.example.json for the shape.
ALPHACI_BUILD_PROFILE=enterprise
ALPHACI_EDITION=enterprise
ALPHACI_CLIENT=st-peter
ALPHACI_CLIENT_CONFIG=
