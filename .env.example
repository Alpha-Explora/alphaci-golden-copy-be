# =============================================================================
# Environment Variable Reference — Sensitivity Classification
# =============================================================================
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# Store HIGH-sensitivity values in GitHub Secrets / Vault / your cloud
# provider's secret manager — not in plaintext files on developer machines.
#
# Sensitivity levels used here:
#   LOW    — safe to log, share in tickets, or store unencrypted in CI env vars
#   MEDIUM — treat like a password: do not log, rotate on breach, but not a
#             root credential
#   HIGH   — treat like a private key: store in Vault/Secrets Manager, rotate
#             immediately on breach, never pass as a CLI argument or log
#
# =============================================================================

# -----------------------------------------------------------------------------
# Service identity
# NODE_ENV       — LOW sensitivity
#                  Controls framework behaviour (error verbosity, Swagger, etc.)
#                  Values: development | test | production
# -----------------------------------------------------------------------------
NODE_ENV=development

# DEV_QUICK_LOGIN — LOW sensitivity
#                    Optional local-development convenience. Set to true only
#                    when running the backend on a loopback address; it creates
#                    a fixed fixture user with a normal session cookie. The
#                    backend forces this off outside NODE_ENV=development and
#                    the endpoint rejects non-loopback requests. Never enable
#                    this in a deployment environment.
DEV_QUICK_LOGIN=false

# SESSION_SECRET — HIGH sensitivity
#                  Secret used to sign the session cookie. Must be at least
#                  32 characters. Generate a strong value with:
#                  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#                  Store in Vault / GitHub Secrets — never commit the real value.
SESSION_SECRET=replace-me-with-at-least-32-character-secret-value

# SESSION_COOKIE_SAMESITE — LOW sensitivity
#                  lax | strict | none. Unset = 'none' when SESSION_SECURE=true
#                  (FE and BE on different sites), else 'lax'. Set 'lax' once
#                  the browser only talks to one site: the FE rewrite proxy
#                  (API_PROXY_TARGET on the FE) or shared subdomains. 'none'
#                  requires SESSION_SECURE=true. See
#                  docs/runbooks/runbook-auth-custom-domain-cutover.md.
# SESSION_COOKIE_SAMESITE=

# TRUST_PROXY_HOPS — LOW sensitivity
#                  Reverse proxies in front of the app. Default 1 (Render's
#                  edge). Set 2 while the FE's Vercel rewrite proxies the API,
#                  or rate limiting sees every user as Vercel's IP. Never set
#                  it above the real chain: each extra hop lets clients spoof
#                  X-Forwarded-For.
# TRUST_PROXY_HOPS=1

# PORT           — LOW sensitivity
#                  TCP port the HTTP server binds to inside the container.
#                  The container port is remapped by the orchestrator; this
#                  value is not externally visible.
# -----------------------------------------------------------------------------
PORT=4000

# ENABLE_SWAGGER — LOW sensitivity
#                  Set to true ONLY in development/local environments.
#                  Swagger UI exposes full API schema — never enable in prod.
# -----------------------------------------------------------------------------
ENABLE_SWAGGER=false

# -----------------------------------------------------------------------------
# Supabase
# SUPABASE_URL              — LOW sensitivity
#                             Public HTTPS endpoint for your Supabase project.
#                             Visible in Supabase dashboard Settings > API.
# SUPABASE_ANON_KEY         — MEDIUM sensitivity
#                             JWT signed with the project's anon role. Safe for
#                             server-side use because RLS policies apply. Do not
#                             expose to end-user browsers from this service.
# SUPABASE_SERVICE_ROLE_KEY — HIGH sensitivity
#                             Bypasses all Row Level Security. Full database
#                             access with no restrictions. Store in Vault or
#                             GitHub Secrets — never in a .env file committed
#                             to any repository.
#
# Optional service-scoped Supabase clients for microservice/tribe routing:
#   <SERVICE>_SUPABASE_URL
#   <SERVICE>_SUPABASE_SECRET_KEY
# or
#   <SERVICE>_SUPABASE_SERVICE_ROLE_KEY
#
# Examples:
#   PAYMENT_SERVICE_SUPABASE_URL=https://payment-project.supabase.co
#   PAYMENT_SERVICE_SUPABASE_SECRET_KEY=payment-service-role-key
#   CHAT_SERVICE_SUPABASE_URL=https://chat-project.supabase.co
#   CHAT_SERVICE_SUPABASE_SECRET_KEY=chat-service-role-key
#
# Each scoped service must define both URL + secret key to be activated.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# CORS
# ALLOWED_ORIGINS — LOW sensitivity
#                   Comma-separated list of browser origins permitted to call
#                   this API. Example: http://localhost:5173,https://app.example.com
#                   No wildcard (*) is accepted — the CORS factory enforces
#                   exact-match whitelisting.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# AlphaCI frontend, backend callback origin, and workflow template source
# FRONTEND_URL          — LOW sensitivity
#                         Browser URL for the active Next.js portal. Used for
#                         OAuth redirects after login.
# PLATFORM_PUBLIC_URL   — LOW sensitivity
#                         Public backend origin used in generated CI callback
#                         URLs. May include or omit /api/v1.
#                         If unset, generated workflows derive it from
#                         GITHUB_CALLBACK_URL.
# TEMPLATE_REPO_PATH    — LOW sensitivity
#                         Local path to the central workflow engine repository.
# TEMPLATE_WORKFLOW_DIR — LOW sensitivity
#                         Directory inside TEMPLATE_REPO_PATH containing
#                         renderable workflow templates.
# CENTRAL_WORKFLOW_REF  — LOW sensitivity
#                         Git ref (tag/branch) of the central reusable workflows
#                         that generated pipelines pin to
#                         (Alpha-Explora/alphaci-workflow). The external
#                         (sold) deployment uses `v1`. The INTERNAL Alphaexplora
#                         deployment sets this to `internal-v1` so its pipelines
#                         track a separate, independently-versioned tag and never
#                         collide with the customer-facing `v1` line. Per-project
#                         overrides still take precedence. Default: v1
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
PLATFORM_PUBLIC_URL=http://localhost:4000
TEMPLATE_REPO_PATH=../alphaci-workflow
TEMPLATE_WORKFLOW_DIR=workflow-templates/customer
CENTRAL_WORKFLOW_REF=v1

# -----------------------------------------------------------------------------
# Entitlement
#
# This deployment has no payment gateway. Entitlement is agreed by contract and
# granted administratively, so nothing here collects money.
#
# SUBSCRIPTION_GATE_ENABLED — LOW sensitivity
#                        Set to "false" for contract-billed deployments: every
#                        authenticated user is treated as fully entitled (pro /
#                        active / manual) and no billing row is required. This
#                        is honoured in two places that must agree —
#                        SubscriptionService.getForUser for the app, and
#                        CiService for pipeline run validation. Leaving it at
#                        the default ("true") means users without an active
#                        billing.user_subscriptions row are blocked, and their
#                        generated pipelines fail at the validate-access job.
#                        Any value other than "false" is treated as true.
# SUBSCRIPTION_MOCK_ENABLED — LOW sensitivity
#                        Gates POST /subscription/monthly/activate. With the
#                        gateway gone this endpoint is the only way to write an
#                        entitlement row by hand; it stays off by default.
# PRO_MONTHLY_PRICE_PHP  LOW sensitivity
#                        Nominal plan amount recorded on entitlement rows. No
#                        charge is ever raised against it.
# -----------------------------------------------------------------------------
SUBSCRIPTION_GATE_ENABLED=false
SUBSCRIPTION_MOCK_ENABLED=false
PRO_MONTHLY_PRICE_PHP=300

# -----------------------------------------------------------------------------
# Environment provisioning (feature flagged)
# ENV_PROVISIONING_ENABLED        LOW sensitivity
#                                 Set true to expose provider/env provisioning UI
#                                 and API routes.
# ENV_PROVISIONING_OWNERSHIP_MODE LOW sensitivity
#                                 Deployment ownership model this deployment
#                                 offers. 'byo' (default) = users connect their
#                                 own Render/Vercel accounts (external/sold
#                                 product). 'flowci_managed' = deployments are
#                                 centralized on the ORGANIZATION's Render/Vercel
#                                 via the FLOWCI_* credentials below (internal
#                                 Alphaexplora deployment); BYO is not offered.
# ENV_PROVISIONING_ENCRYPTION_KEY HIGH sensitivity
#                                 Base64-encoded 32-byte key used to encrypt BYO
#                                 Render/Vercel provider tokens at rest.
#                                 Generate with:
#                                 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FLOWCI_RENDER_API_KEY           HIGH sensitivity
#                                 FlowCI-managed Render API key. Required only
#                                 when using flowci_managed Render targets.
# FLOWCI_RENDER_OWNER_ID          LOW sensitivity
#                                 FlowCI-managed Render workspace id used when
#                                 creating services. Starts with tea-. Required
#                                 for deterministic FlowCI-managed Render
#                                 project creation.
# FLOWCI_RENDER_DEFAULT_REGION    LOW sensitivity
#                                 Default Render region for managed services.
# FLOWCI_RENDER_DEFAULT_INSTANCE_TYPE LOW sensitivity
#                                 Default managed Render instance. Use free
#                                 unless paid managed provisioning is approved.
# FLOWCI_RENDER_ALLOWED_INSTANCE_TYPES LOW sensitivity
#                                 Comma-separated managed allowlist.
# FLOWCI_RENDER_ALLOW_PAID_MANAGED LOW sensitivity
#                                 Set true only after managed billing controls
#                                 and quotas are approved.
# FLOWCI_RENDER_MANAGED_MAX_SERVICES_PER_USER LOW sensitivity
#                                 Managed Render quota guard.
# FLOWCI_RENDER_BOOTSTRAP_IMAGE   LOW sensitivity
#                                 Initial image used before GitHub Actions
#                                 pushes the project image.
# FLOWCI_RENDER_REGISTRY_CREDENTIAL_ID MEDIUM sensitivity
#                                 Render registry credential id for private
#                                 GHCR image pulls.
# FLOWCI_VERCEL_TOKEN             HIGH sensitivity
#                                 FlowCI-managed Vercel token. Required only
#                                 when using flowci_managed Vercel targets.
# FLOWCI_VERCEL_TEAM_ID           MEDIUM sensitivity
#                                 REQUIRED for managed Vercel targets, not
#                                 optional: provisioning rejects the request
#                                 without it. The token alone is not enough -
#                                 it says who is asking, this says where the
#                                 project is created. Must name a team the
#                                 token's owner can create projects in.
# FLOWCI_VERCEL_TEAM_SLUG         LOW sensitivity
#                                 Optional Vercel team slug for display/routing.
# -----------------------------------------------------------------------------
ENV_PROVISIONING_ENABLED=false
# On-prem host registration and the host agent API (release registry). Off
# until this deployment serves customer-hosted targets.
ONPREM_RELEASES_ENABLED=false
# JSON object mapping trusted release-signing key IDs to PEM public keys.
# Required before a release manifest can be accepted as verified. Example:
# ALPHACI_RELEASE_TRUST_KEYS_JSON={"projects/alphaci/keys/release/1":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}
ALPHACI_RELEASE_TRUST_KEYS_JSON={}
# Cloud KMS key version that signs release manifests (ECDSA P-256,
# EC_SIGN_P256_SHA256), as projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY/cryptoKeyVersions/VERSION.
# Production signing. Provisioning copies this value to each on-prem project as the
# repository variable of the same name, so the signing job uses it. Trust the same
# key version's public key in ALPHACI_RELEASE_TRUST_KEYS_JSON under this exact name.
ALPHACI_RELEASE_KMS_KEY_VERSION=
# Cloud KMS signer identity for the sign-release job. It is not the Cloud Run runtime
# pool (GCP_WORKLOAD_IDENTITY_PROVIDER). Set all three Cloud KMS settings together:
# without these two, Cloud KMS is not configured and the lab key is not used either.
# Provisioning writes them into the generated sign-release job as workflow inputs.
ALPHACI_RELEASE_SIGNER_WORKLOAD_IDENTITY_PROVIDER=
ALPHACI_RELEASE_SIGNER_SERVICE_ACCOUNT=
# LAB ONLY. Path to a PEM file holding a local P-256 private key
# (openssl ecparam -name prime256v1). Used only when no Cloud KMS setting is present. A set
# but incomplete Cloud KMS configuration is an error, not a lab fallback. Provisioning copies the key into the repository secret ALPHACI_RELEASE_SIGNING_KEY.
# Client hosts must not use it. The backend process must be able to read the file.
ONPREM_LAB_SIGNING_KEY_PATH=
# Versioned installer archive; build locally with scripts/package-onprem-agent.mjs.
# Configure all four before issuing enrollment codes. The API verifies the file hash.
ONPREM_INSTALLER_VERSION=0.1.0
ONPREM_INSTALLER_URL=
ONPREM_INSTALLER_SHA256=
ONPREM_INSTALLER_PATH=
ENV_PROVISIONING_OWNERSHIP_MODE=byo
ENV_PROVISIONING_ENCRYPTION_KEY=
FLOWCI_RENDER_API_KEY=
FLOWCI_RENDER_OWNER_ID=
FLOWCI_RENDER_DEFAULT_REGION=singapore
FLOWCI_RENDER_DEFAULT_INSTANCE_TYPE=free
FLOWCI_RENDER_ALLOWED_INSTANCE_TYPES=free
FLOWCI_RENDER_ALLOW_PAID_MANAGED=false
FLOWCI_RENDER_MANAGED_MAX_SERVICES_PER_USER=2
FLOWCI_RENDER_BOOTSTRAP_IMAGE=docker.io/library/nginx:alpine
FLOWCI_RENDER_REGISTRY_CREDENTIAL_ID=
FLOWCI_VERCEL_TOKEN=
FLOWCI_VERCEL_TEAM_ID=
FLOWCI_VERCEL_TEAM_SLUG=

# -----------------------------------------------------------------------------
# QA checklists (feature flagged, on by default)
# QA_CHECKLISTS_ENABLED  LOW sensitivity
#                        Set to "false" to hide checklist creation/sharing
#                        routes. Any value other than "false" is treated as
#                        enabled. Team leads and admins (identity.app_users.
#                        app_role) create checklists at workspace scope and
#                        share them to that workspace's projects.
# -----------------------------------------------------------------------------
QA_CHECKLISTS_ENABLED=true

# -----------------------------------------------------------------------------
# GitHub OAuth (required for GitHub login)
#
# GITHUB_CLIENT_ID     — MEDIUM sensitivity
#                        OAuth App client ID from GitHub Settings > Developer settings.
# GITHUB_CLIENT_SECRET — HIGH sensitivity
#                        OAuth App client secret. Store in Vault / GitHub Secrets.
# GITHUB_CALLBACK_URL  — LOW sensitivity
#                        Must match the Authorization callback URL registered in your
#                        GitHub OAuth App settings.
# GITHUB_SCOPE         — LOW sensitivity
#                        Comma- or space-separated GitHub OAuth scopes. The product
#                        creates repos (needs `repo`) and pushes workflow files
#                        (needs `workflow`). Internal-org gating additionally needs
#                        `read:org` to read the signed-in user's org membership.
#                        Default: repo,workflow,read:org
# GITHUB_INTERNAL_ORG  — LOW sensitivity
#                        Login of the internal company GitHub org. When SET, this
#                        deployment becomes the INTERNAL workspace: members of this
#                        org are marked internal (is_internal=true) and bypass the
#                        subscription/payment gate; NON-members are hard-blocked at
#                        login. Leave EMPTY on the external (sold) deployment to
#                        disable internal gating entirely. Example: my-company-org
# GITHUB_ENFORCED_ORG  — LOW sensitivity
#                        Login of the org that EVERY created repository must
#                        belong to. When set, the product always creates repos
#                        in this org (never in personal accounts); ownerType /
#                        installationId on the request are ignored. Requires the
#                        GitHub App installed on this org with access to ALL
#                        repositories, and the signed-in user to be a member.
#                        REQUIRED. There is no default org: unset or blank makes
#                        repository creation fail with "no destination org is
#                        configured" rather than picking one. A fallback would
#                        silently provision into whichever org it named, which on
#                        a deployment pointed at a sandbox means writing to
#                        production. Empty does NOT restore per-request owner
#                        choice — creation into personal accounts was removed.
#
# GITHUB_TEAM_ROLE_SYNC — LOW sensitivity
#                        Whether GitHub org TEAM membership drives a user's
#                        global role (identity.app_users.app_role).
#                          off     — (default) never read teams. Legacy
#                                    behaviour: app_role is seeded from org
#                                    OWNERSHIP on first login only.
#                          seed    — team membership seeds app_role on first
#                                    login only; the Admin Console owns it
#                                    from then on.
#                          enforce — app_role is re-derived on EVERY login and
#                                    by the `membership` webhook, except for
#                                    users pinned to app_role_source='manual'
#                                    by an Admin Console edit.
#                        Any unrecognized value falls back to "off".
#                        REQUIRES the GitHub App to have org "Members: Read".
#                        Without it every team check is unreadable and — by
#                        design — no role is ever changed.
# GITHUB_TEAM_LEAD_SLUG — LOW sensitivity
#                        Slug of the org team whose members become global
#                        'lead' (may create projects). Default: team-lead
# GITHUB_TEAM_DEVELOPER_SLUG — LOW sensitivity
#                        Slug of the org team whose members become global
#                        'member' (assigned work only). Default: developers
# GITHUB_TEAM_QA_SLUG — LOW sensitivity
#                        Slug of the org team whose members become global
#                        'qa' (QA Team: verify and sign off, cannot create).
#                        Precedence: team-lead > qa-team > developers.
#                        Default: qa-team
# GITHUB_TEAM_ROLE_RECONCILE_INTERVAL_MS — LOW sensitivity
#                        How often the reconciliation sweep re-reads both team
#                        rosters (lead, qa, developer) and corrects any app_role that drifted — the
#                        safety net for `membership` webhook deliveries that
#                        were missed or arrived while the service was down.
#                        Costs 3 GitHub API calls per sweep regardless of user
#                        count. 0 disables it. Only runs under
#                        GITHUB_TEAM_ROLE_SYNC=enforce. Default: 900000 (15m)
#
# MEMBER_DIRECTORY_SOURCE — LOW sensitivity
#                        Where this deployment's people come from: the pool a
#                        workspace lead adds members from, and what
#                        GET /api/v1/directory/members returns. See ADR-0011.
#                          github_org  members of MEMBER_DIRECTORY_ORG on GitHub
#                                      (default)
#                          accounts    every active AlphaCI account; only for a
#                                      deployment whose sign-in already decides
#                                      who belongs (no GitHub org)
#                        An unknown value stops the boot.
# MEMBER_DIRECTORY_ORG  — LOW sensitivity
#                        The GitHub org behind github_org. Default:
#                        GITHUB_ENFORCED_ORG. The roster is read with the
#                        signed-in lead's own token (read:org), falling back
#                        to a recorded GitHub App installation.
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# GitHub App (distinct from the OAuth App above)
#
# The OAuth App authenticates the *user*. The GitHub App acts as the *platform*:
# it creates repositories, pushes workflow files, and reads org team membership.
# You need both, registered separately.
#
# All three are REQUIRED when NODE_ENV=production — env.validation.ts rejects a
# missing or placeholder value at boot rather than letting the service start
# and fail later during repo provisioning.
#
# GITHUB_APP_ID          — MEDIUM sensitivity
#                          Numeric App ID. Digits only. Alias: GITHUB_APP.
# GITHUB_APP_SLUG        — LOW sensitivity
#                          The App's URL slug. The literal placeholder
#                          "my-github-app" is explicitly rejected.
# GITHUB_APP_PRIVATE_KEY — HIGH sensitivity
#                          PEM private key generated in the App's settings.
#                          Newlines may be \n-escaped on a single line. Store in
#                          Vault / GitHub Secrets — never commit the real key.
#                          Alias: GITHUB_PRIVATE_KEY.
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
GITHUB_SCOPE=repo,workflow,read:org
GITHUB_INTERNAL_ORG=
GITHUB_ENFORCED_ORG=Alpha-Explora
GITHUB_TEAM_ROLE_SYNC=off
GITHUB_TEAM_LEAD_SLUG=team-lead
GITHUB_TEAM_DEVELOPER_SLUG=developers
GITHUB_TEAM_QA_SLUG=qa-team
MEMBER_DIRECTORY_SOURCE=github_org
MEMBER_DIRECTORY_ORG=
GITHUB_TEAM_ROLE_RECONCILE_INTERVAL_MS=900000
ARCHIVED_ACCOUNT_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Outbox relay (process:outbox / Render Cron Job)
#
# The relay is an in-process Nest application-context job. It owns the single
# `platform.outbox_events` table and dispatches only topics with a registered
# in-process handler. Configure one scheduler for `npm run process:outbox`.
#
# SUPABASE_DB_URL      — HIGH sensitivity
#                        Postgres connection string used by the web process and
#                        the short-lived relay job.
#
#                        NOTE: on this project, port 5432 is itself proxied
#                        through Supavisor in session mode (Supabase now routes
#                        most "direct" hostnames through Supavisor rather than
#                        raw Postgres) — Postgres logs show every connection
#                        authenticating as `pgbouncer`/`Supavisor`, not a bare
#                        libpq session. That means this URL is capped by the
#                        project's session-mode pool_size (Project Settings >
#                        Database > Connection Pooling), NOT by Postgres's own
#                        max_connections. Every `new Pool()` anywhere in this
#                        codebase that points at THIS SAME URL draws from that
#                        one shared ceiling — the NestJS app pool
#                        (database.service.ts, max 3), the connect-pg-simple
#                        session store (main.ts), and this relay job
#                        all compete for the same pool_size budget, and it gets
#                        worse with >1 Render web instance. We've hit
#                        `(EMAXCONNSESSION) max clients reached in session
#                        mode` in production from this. Before adding a new
#                        `Pool()` against SUPABASE_DB_URL: (1) always set an
#                        explicit `max` sized to actual concurrency need — never
#                        leave it uncapped, and (2) prefer routing short-lived,
#                        session-feature-free connections (no LISTEN/NOTIFY, no
#                        multi-statement advisory locks) through the
#                        transaction-mode pooler on port 6543 instead, since it
#                        multiplexes far more clients per pool_size slot.
# SUPABASE_DB_CA_CERT  — MEDIUM sensitivity (optional)
#                        PEM CA certificate for Postgres TLS verification when
#                        the provider's CA chain is not in Node's default trust
#                        store. Escaped \n sequences are supported.
# OUTBOX_BATCH_SIZE     — LOW sensitivity; maximum rows per scheduled run.
# OUTBOX_MAX_ATTEMPTS   — LOW sensitivity; retry limit before quarantine.
# OUTBOX_RETRY_DELAY_SECONDS — LOW sensitivity; retry delay.
# OUTBOX_LEASE_SECONDS  — LOW sensitivity; abandoned claim lease duration.
#                          Must be longer than OUTBOX_HANDLER_TIMEOUT_MS.
# OUTBOX_HANDLER_TIMEOUT_MS — LOW sensitivity; maximum handler wait.
# HIERARCHY_GITHUB_SYNC_MODE — LOW sensitivity; required by the relay: live or
#                              stub. The scheduled relay refuses an unset value.
# -----------------------------------------------------------------------------
SUPABASE_DB_URL=postgres://postgres:your-password@your-host.supabase.co:5432/postgres
# SUPABASE_DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_DELAY_SECONDS=60
OUTBOX_LEASE_SECONDS=300
OUTBOX_HANDLER_TIMEOUT_MS=120000
# HIERARCHY_GITHUB_SYNC_MODE=stub

# =============================================================================
# Render deployment — environment variable instructions
# =============================================================================
#
# For Render deployments, configure runtime variables in Render Environment
# settings (do not commit a production .env file).
#
# Variables to configure in Render environment settings:
#
#   NODE_ENV                  = production
#   PORT                      = 4000
#   ENABLE_SWAGGER            = false
#   SUPABASE_URL              = https://your-project.supabase.co
#   SUPABASE_ANON_KEY         = <your anon key>
#   SUPABASE_SERVICE_ROLE_KEY = <your service role key>
#
#   GITHUB_CLIENT_ID          = <GitHub OAuth App client ID>
#   GITHUB_CLIENT_SECRET      = <GitHub OAuth App client secret>
#   GITHUB_CALLBACK_URL       = <public callback URL registered in GitHub OAuth App>
#
#   FRONTEND_URL              = <public frontend URL for OAuth redirects>
#   PLATFORM_PUBLIC_URL       = <public backend origin used by generated workflows>
#   TEMPLATE_REPO_PATH        = ../cicd-workflow
#   TEMPLATE_WORKFLOW_DIR     = workflow-templates
#
#   ALLOWED_ORIGINS — add exact frontend URL(s) for each environment.
#   Example:
#     https://test.example.com,https://uat.example.com,https://app.example.com
#   Do NOT use a bare wildcard (*) — the CORS factory enforces exact matching.
#
# Generated customer repositories receive per-slot Render deployment secrets:
#   RENDER_BACKEND_API_KEY
#   RENDER_BACKEND_SERVICE_ID
#   RENDER_BACKEND_OWNER_ID
#   RENDER_BACKEND_REGISTRY_CREDENTIAL_ID
#   RENDER_STANDALONE_API_KEY
#   RENDER_STANDALONE_SERVICE_ID
#   RENDER_STANDALONE_OWNER_ID
#   RENDER_STANDALONE_REGISTRY_CREDENTIAL_ID
#
# The central workflow builds and pushes a GHCR image, then calls:
#   POST /v1/services/{serviceId}/deploys
# with the pushed imageUrl.
# =============================================================================

# -----------------------------------------------------------------------------
# Canonical GCP deployment provider (disabled by default)
# GCP_DEPLOYMENTS_ENABLED              LOW sensitivity
#                                      Enables GCP provider discovery and the
#                                      authenticated Cloud Run runtime adapter.
# GCP_SHARED_PROJECT_ID                LOW sensitivity
#                                      GCP project that owns shared runtimes.
# GCP_REGION                           LOW sensitivity
#                                      Cloud Run / Artifact Registry region.
# GCP_ARTIFACT_REGISTRY_REPOSITORY     LOW sensitivity
#                                      Docker repository for managed images.
# GCP_WORKLOAD_IDENTITY_PROVIDER        MEDIUM sensitivity
#                                      Reserved for keyless CI identity setup.
# GCP_DEPLOYER_SERVICE_ACCOUNT          MEDIUM sensitivity
#                                      Reserved for keyless CI deployments.
# GCP_DEDICATED_PROJECTS_ENABLED        LOW sensitivity
#                                      Enables the future dedicated-project lane.
# -----------------------------------------------------------------------------
GCP_DEPLOYMENTS_ENABLED=false
GCP_SHARED_PROJECT_ID=
GCP_REGION=asia-southeast1
GCP_ARTIFACT_REGISTRY_REPOSITORY=
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_DEPLOYER_SERVICE_ACCOUNT=
GCP_DEDICATED_PROJECTS_ENABLED=false

# -----------------------------------------------------------------------------
# Composition
# ALPHACI_BUILD_PROFILE — LOW sensitivity
#                         Artifact ceiling. Values: hosted | enterprise.
#                         hosted compiles the SaaS and EDU packs; enterprise
#                         compiles the Enterprise pack. Defaults to enterprise.
# ALPHACI_EDITION       — LOW sensitivity
#                         Which pack manifest this deployment resolves.
#                         Values: saas | edu | enterprise. Defaults to
#                         enterprise. saas and edu require the hosted profile;
#                         a mismatch stops the boot rather than resolving a
#                         manifest the artifact never compiled.
# ALPHACI_CLIENT        — LOW sensitivity
#                         Optional client whose deny-only policy narrows the
#                         edition manifest. Must name a policy declared in
#                         src/kernel/composition/clients, or be paired with
#                         ALPHACI_CLIENT_CONFIG. Unknown values stop the boot.
# ALPHACI_CLIENT_CONFIG — LOW sensitivity
#                         Optional path to a client policy JSON document. Use
#                         it for a customer-hosted deployment that carries its
#                         own composition without a product release. When both
#                         are set, the document must name the same client.
#                         See deploy/env for ready-made combinations.
# -----------------------------------------------------------------------------
ALPHACI_BUILD_PROFILE=enterprise
ALPHACI_EDITION=enterprise
ALPHACI_CLIENT=
ALPHACI_CLIENT_CONFIG=
